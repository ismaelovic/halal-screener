# API
APP_ENV="development"

# Database (Supabase Postgres connection string).
# Local dev fallback is SQLite so you can boot the app with zero external setup.
DATABASE_URL="sqlite:///./halal_screener.db"

# EODHD fundamentals API (https://eodhd.com/financial-apis/) — optional.
# Not currently used: the seed script uses yfinance (no key needed) because
# EODHD's Fundamentals Data Feed requires a paid add-on ($59.99/mo), not
# included in the free plan. Kept here in case that changes later.
EODHD_API_KEY=""
